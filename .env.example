# Copy to .env.dev and fill in values.
# These are the variables the app reads in dev and lab.

ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://postgres:devsecret@localhost:5432/fieldproof
JWT_SECRET=change-me-in-staging-and-prod
DATABASE_PASSWORD=devsecret
BACKUP_PASSPHRASE=change-me-in-staging-and-prod
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# AWS
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=

# Backup S3 (optional)
BACKUP_S3_BUCKET=
